name: Deploy environment

on:
  workflow_call:
    inputs:
      environment:
        description: Environment to deploy to (uat or prod)
        required: true
        type: string
      secret_prefix:
        description: Prefix of this environment's secrets and variables (UAT or PROD)
        required: true
        type: string

permissions:
  contents: read

jobs:
  deploy:
    name: Build, push and deploy to ${{ inputs.environment }}
    runs-on: ubuntu-latest
    # No GitHub Environment (they need a paid plan on private repos). Secrets and variables are
    # repository level, named <PREFIX>_<NAME>, and picked with inputs.secret_prefix.
    # One deploy per environment at a time (several open PRs share UAT), and never cancel one part way through.
    concurrency:
      group: deploy-{{service}}-${{ inputs.environment }}
      cancel-in-progress: false

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Get commit SHA
        id: vars
        run: echo "short_sha=$(git rev-parse --short ${{ github.sha }})" >> "$GITHUB_OUTPUT"

      - name: Log in to Azure Container Registry (ACR)
        uses: azure/docker-login@v2
        with:
          login-server: ${{ vars[format('{0}_ACR_SERVER', inputs.secret_prefix)] }}
          username: ${{ secrets[format('{0}_ACR_USERNAME', inputs.secret_prefix)] }}
          password: ${{ secrets[format('{0}_ACR_PASSWORD', inputs.secret_prefix)] }}

      - name: Build and push image
        env:
          IMAGE: ${{ vars[format('{0}_ACR_SERVER', inputs.secret_prefix)] }}/{{image_name}}:${{ steps.vars.outputs.short_sha }}
        run: |
          docker build -f {{dockerfile}} -t "$IMAGE" .
          docker push "$IMAGE"

      - name: Log in to Azure
        uses: azure/login@v3
        with:
          creds: ${{ secrets[format('{0}_AZURE_CREDENTIALS', inputs.secret_prefix)] }}

      - name: Deploy to Azure Container Apps (ACA)
        uses: azure/container-apps-deploy-action@v1
{{app_env}}        with:
          registryUrl: ${{ vars[format('{0}_ACR_SERVER', inputs.secret_prefix)] }}
          imageToDeploy: ${{ vars[format('{0}_ACR_SERVER', inputs.secret_prefix)] }}/{{image_name}}:${{ steps.vars.outputs.short_sha }}
{{ingress}}          containerAppName: {{prefix}}-{{service}}-${{ inputs.environment }}
          containerAppEnvironment: {{prefix}}-{{service}}-${{ inputs.environment }}-cae
          resourceGroup: {{prefix}}-{{service}}-${{ inputs.environment }}-rg
{{env_vars}}
