# Build once, run on the smaller runtime image.
FROM mcr.microsoft.com/dotnet/sdk:{{dotnet_major}}.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish {{project_path}} --configuration Release --output /app

FROM mcr.microsoft.com/dotnet/{{runtime_image}}:{{dotnet_major}}.0 AS final
WORKDIR /app
COPY --from=build /app .
{{expose}}ENTRYPOINT ["dotnet", "{{assembly}}.dll"]
